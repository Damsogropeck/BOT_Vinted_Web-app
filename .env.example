# =============================================================
#  VINTED-BOT — Variables d'environnement
#  Copie ce fichier en ".env" et remplis les valeurs réelles.
#  Ne commite JAMAIS le fichier .env (il est dans .gitignore).
# =============================================================

# --- Serveur ---
NODE_ENV=production
# PORT est fourni automatiquement par InstaPods, ne pas le définir manuellement
# PORT=3000

# --- Base de données SQLite ---
# Chemin vers le fichier de base de données (relatif à la racine du projet)
# Sur un pod avec disque persistant, ce chemin convient tel quel.
DB_PATH=backend/storage/vinted-bot.db

# --- Scraper Vinted ---
SCRAPE_INTERVAL_SECONDS=45
SCRAPER_DELAY_MS=1200
SCRAPER_MIN_DELAY_MS=900
SCRAPER_MAX_DELAY_MS=1800
MAX_ITEMS_PER_SEARCH=20
MAX_DETAIL_REQUESTS_PER_RUN=2
MAX_HTTP_REQUESTS_PER_SEARCH=6
HTTP_RETRIES=2
HTTP_TIMEOUT_MS=12000
HTTP_RETRY_BASE_DELAY_MS=350
ENABLE_DETAIL_ENRICHMENT=true

# --- Logs ---
# Valeurs possibles : debug | info | warn | error
LOG_LEVEL=warn

# --- Nettoyage automatique ---
MAX_ITEM_AGE_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# --- Notifications Web Push (VAPID) ---
# Génère tes propres clés avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=REMPLACE_PAR_TA_CLE_PUBLIQUE_VAPID
VAPID_PRIVATE_KEY=REMPLACE_PAR_TA_CLE_PRIVEE_VAPID
VAPID_SUBJECT=mailto:ton@email.com

# --- Frontend (lues par Vite au moment du build) ---
# Doit être identique à VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=REMPLACE_PAR_TA_CLE_PUBLIQUE_VAPID
# Laisser vide si API_TOKEN est vide
VITE_API_TOKEN=

# --- Sécurité (optionnels) ---
# Restreint les appels API écriture à ce token (laisser vide = pas d'auth)
API_TOKEN=
# Restreint CORS à cette origine (laisser vide = autorise tout)
ALLOWED_ORIGIN=
